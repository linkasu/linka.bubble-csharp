<Window x:Class="Linka.Bubble.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="Manual"
        Width="44" Height="44">
    <Grid IsHitTestVisible="False">
        <Ellipse x:Name="BubbleFill" Fill="#198FD9" Margin="3" />
        <Ellipse Stroke="White" StrokeThickness="2" Margin="2" />
        <Ellipse Stroke="#242C37" StrokeThickness="1" Margin="4" />
        <Ellipse Fill="White" Width="4" Height="4" />
    </Grid>
</Window>
