<Window x:Class="Linka.Bubble.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Линка.Пузырик — настройки" Width="440" Height="410"
        MinWidth="380" MinHeight="390" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Показ взгляда" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
        <CheckBox x:Name="ShowBubble" Content="Показывать пузырёк"
                  Checked="OnChanged" Unchecked="OnChanged" Margin="0,0,0,16" />

        <Label Content="Размер пузырька" Target="{Binding ElementName=SizeSlider}" Padding="0" />
        <Slider x:Name="SizeSlider" Minimum="20" Maximum="100" TickFrequency="1"
                IsSnapToTickEnabled="True" ValueChanged="OnChanged"
                AutomationProperties.Name="Размер пузырька" Margin="0,4,0,14" />

        <Label Content="Яркость" Target="{Binding ElementName=BrightnessSlider}" Padding="0" />
        <Slider x:Name="BrightnessSlider" Minimum="10" Maximum="100" TickFrequency="1"
                IsSnapToTickEnabled="True" ValueChanged="OnChanged"
                AutomationProperties.Name="Яркость пузырька" Margin="0,4,0,14" />

        <Label Content="Плавность: точнее — спокойнее" Target="{Binding ElementName=SmoothnessSlider}" Padding="0" />
        <Slider x:Name="SmoothnessSlider" Minimum="0" Maximum="100" TickFrequency="1"
                IsSnapToTickEnabled="True" ValueChanged="OnChanged"
                AutomationProperties.Name="Плавность движения пузырька" Margin="0,4,0,14" />

        <TextBlock x:Name="StatusText" Text="Подключаемся" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal">
            <Button Content="Вернуть исходный вид" Click="ResetAppearance" Padding="10,5" />
            <Button Content="Закрыть" Click="CloseSettings" Padding="10,5" Margin="12,0,0,0" />
        </StackPanel>
        <TextBlock Text="Пузырёк показывает приблизительное положение взгляда и не управляет компьютером. Калибровка выполняется в программе Tobii."
                   TextWrapping="Wrap" Margin="0,14,0,0" />
    </StackPanel>
</Window>
